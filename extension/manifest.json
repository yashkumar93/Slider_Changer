{
  "manifest_version": 3,
  "name": "Slides Phone Remote",
  "version": "2.0.0",
  "description": "Start the local Slides Phone Remote server and control the active presentation from your phone.",
  "permissions": ["alarms", "storage", "nativeMessaging"],
  "host_permissions": [
    "http://127.0.0.1:8765/*",
    "http://localhost:8765/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Slides Phone Remote"
  },
  "key": ""
}
